<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Tents</AssemblyName>
    <RootNamespace>Tents.App</RootNamespace>
    <!-- Workstation non-concurrent GC: no background GC thread (PROJECT_PLAN.md section 7, spike 3). -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Per-monitor v2 DPI awareness (M1 step 13). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Original artwork, drawn by Assets/make-icon.py. Also embedded for the tray icon. -->
    <ApplicationIcon>Assets\Tents.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tents.Tests" />
    <InternalsVisibleTo Include="Tents.RenderMeasure" />
    <!-- UseWPF drops System.IO from the implicit usings (WPF has its own Path type); nothing here uses that one. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Tents.ico" LogicalName="Tents.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tents.Core\Tents.Core.csproj" />
    <ProjectReference Include="..\Tents.Shell\Tents.Shell.csproj" />
  </ItemGroup>

</Project>
