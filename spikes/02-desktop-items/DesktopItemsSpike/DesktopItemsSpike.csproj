<Project Sdk="Microsoft.NET.Sdk">

  <!-- THROWAWAY SPIKE CODE for M0 spike 2 (desktop items). Not part of Tents.sln. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Tents.Spikes</RootNamespace>
    <AssemblyName>desktopitems</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>obj\generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Source-generated COM interfaces, so the vtable layouts come from the Win32 metadata rather than from memory. -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.371" PrivateAssets="all" />
    <Compile Include="..\..\common\Native.cs" Link="Native.cs" />
  </ItemGroup>

</Project>
