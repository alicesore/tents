<Project Sdk="Microsoft.NET.Sdk">

  <!-- THROWAWAY SPIKE CODE for M0 spike 2 (desktop items). Not part of Tents.sln. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Tents.Spikes</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Tents.Spikes.Program</StartupObject>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>obj\generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.371" PrivateAssets="all" />
    <AdditionalFiles Include="..\DesktopItemsSpike\NativeMethods.txt" Link="NativeMethods.txt" />
    <Compile Include="..\..\common\Native.cs" Link="Native.cs" />
    <Compile Include="..\DesktopItemsSpike\DesktopView.cs" Link="DesktopView.cs" />
  </ItemGroup>

</Project>
