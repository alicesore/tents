<Project Sdk="Microsoft.NET.Sdk">

  <!--
    THROWAWAY SPIKE CODE for M0 spike 3 (performance baseline). Not part of Tents.sln.
    A bare Win32 window with GDI painting, no WPF. Published two ways by measure.ps1: on CoreCLR, and with
    -p:PublishAot=true (native code, no JIT), which is the closest stand-in here for a Win32/Direct2D fallback.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Tents.Spikes</RootNamespace>
    <AssemblyName>Win32Tent</AssemblyName>
    <ApplicationManifest>..\app.manifest</ApplicationManifest>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
